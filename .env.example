# Server
PORT=3000

# Database (cadas_app_dev — terpisah dari material_generator_dev di container yang sama)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cadas_app_dev

# Auth
JWT_SECRET=ganti_dengan_secret_acak_panjang

# AskKak Layer 3 (FASE 8) — OpenRouter, BUKAN Ollama (lihat Addendum v1)
# Satu key utama:
OPENROUTER_API_KEY=sk-or-v1-...ganti
# Atau 5 key individual dengan rotasi otomatis:
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...
OPENROUTER_API_KEY_3=sk-or-v1-...
OPENROUTER_API_KEY_4=sk-or-v1-...
OPENROUTER_API_KEY_5=sk-or-v1-...
# Model default (gratis & cocok untuk edukasi matematika)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Billing manual (MVP) — nomor WA admin untuk proses pembayaran
ADMIN_WHATSAPP=6281234567890
