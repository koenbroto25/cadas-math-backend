# Model default (gratis & cocok untuk edukasi matematika)
OPENROUTER_MODEL=openai/gpt-4o-mini

ADMIN_WHATSAPP=6281234567890

# ── Auth (Sprint K.9) — Portal Admin ────────────────────────────────────────
# Dipakai oleh POST /api/auth/admin/login → JWT role 'admin' (TTL 8 jam)
ADMIN_EMAIL=admin@example.com
# bcrypt hash password admin (WAJIB di produksi). Generate:
#   node -e "console.log(require('bcryptjs').hashSync('PASSWORD_KAMU',10))"
ADMIN_PASSWORD_HASH=$2a$10$ganti_dengan_hash_bcrypt
# Fallback plain — HANYA untuk setup awal/dev, jangan di produksi
# ADMIN_PASSWORD=password_plain_sementara
# Secret untuk endpoint /api/admin/* via header x-admin-secret (script/curl/CI)
ADMIN_SECRET=ganti_dengan_secret_acak_panjang

# Lokasi aset audio/viseme lokal di VM (VM-first, pengganti R2)
ASSETS_ROOT=/var/www/cadas/assets
